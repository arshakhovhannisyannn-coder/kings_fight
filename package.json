{
  "name": "arqaneri-mart",
  "productName": "ArqaneriMart",
  "version": "1.4.0",
  "description": "Արքաների Մարտ — հերթափոխային քարտային-մարտավարական խաղ ինտելեկտուալ հակառակորդով",
  "author": "Diploma project",
  "license": "MIT",
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node tools/serve.js",
    "test": "node --test \"tests/*.test.js\"",
    "selfplay": "node tools/selfplay.js",
    "experiments": "node tools/experiments.js",
    "fonts": "node tools/copy-fonts.js",
    "dist": "electron-builder --win portable nsis",
    "icon": "electron tools/make-icon.js",
    "balance": "node tools/balance.js",
    "smoke": "electron tools/ui-smoke.mjs"
  },
  "devDependencies": {
    "@fontsource/noto-sans-armenian": "^5.0.0",
    "@fontsource/noto-serif-armenian": "^5.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "am.diploma.arqanerimart",
    "productName": "ArqaneriMart",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "ArqaneriMart-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "ArqaneriMart-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Արքաների Մարտ",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Արքաների Մարտ"
    }
  }
}
